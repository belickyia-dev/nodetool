# NodeTool PI Deployment Environment Variables
# Copy to .env and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (use the existing db_postgres service)
DATABASE_URL=postgresql://nodetool:your-password@tasks.db_postgres:5432/nodetool

# ── Secret encryption ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SECRETS_MASTER_KEY=

# ── LLM Provider API keys ───────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAL_API_KEY=
KIE_API_KEY=
HF_TOKEN=
