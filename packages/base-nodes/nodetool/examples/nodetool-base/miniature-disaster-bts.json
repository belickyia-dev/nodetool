        "id": "image_prompt_template",
        "type": "nodetool.text.Prompt",
        "data": {
          "prompt": "Behind-the-scenes film set photography. A professional film crew is shooting a practical effects disaster scene using a detailed miniature scale model of {{ city }} city.\n\nThe miniature city model is incredibly detailed with tiny buildings, streets, cars, and palm trees. A {{ disaster }} is happening in the miniature - water/debris/effects are real practical elements.\n\nVisible in frame: professional camera operators with RED cameras on dollies, boom microphones, lighting rigs, director's chair, cables on floor, safety crew watching.\n\nCinematic lighting with dramatic shadows. Shot on Arri Alexa. Shallow depth of field focusing on the miniature disaster. Film set atmosphere with crew members in the background.\n\nHyper-realistic miniature photography, tilt-shift effect, practical effects, behind the scenes documentary style."
        },
        "ui_properties": {
          "position": { "x": 350, "y": 50 },
          "width": 360,
          "height": 340,
          "title": "3️⃣ Image Prompt"
        },
        "dynamic_properties": {
          "city": "Miami",
          "disaster": "tsunami wave crashing through downtown"
        },
        "dynamic_outputs": {}
      },
