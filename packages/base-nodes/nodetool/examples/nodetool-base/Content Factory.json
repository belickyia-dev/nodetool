      {
        "id": "comment",
        "type": "nodetool.workflows.base_node.Comment",
        "data": {
          "comment": "# Content Factory\n\nScale neuro-photo content production across **5 parallel lanes**. One prompt generates 5 unique images with different faces — avoiding duplicate-content shadowbanning across multiple social media accounts.\n\n**Pipeline:** Idea prompt + 5 face references → 5 parallel ImageToImage generations → 5 unique results\n\n**Use case:** Multi-account Instagram/Pinterest content where each account needs unique imagery from the same concept.\n\n**Try this:** Upload 5 different face photos, write one transformation prompt, and generate 5 unique results for 5 accounts."
        },
        "ui_properties": {
          "position": {
            "x": 40,
            "y": -280
          },
          "zIndex": 0,
          "width": 520,
          "height": 220,
          "selectable": true,
          "bypassed": false
        },
        "dynamic_properties": {},
        "dynamic_outputs": {}
      },
